static int aMBX_item_is_this(mActor_name_t item, int arrange_idx);

static void aMBX_anime_proc(ACTOR* actorx, GAME_PLAY* play) {
    static s8 part_tbl[] = { 0, 0, 0, 1, 1, 0, 0 };
    MAILBOX_ACTOR* actor = (MAILBOX_ACTOR*)actorx;

    actor->kf0_state = cKF_SkeletonInfo_R_combine_play(&actor->kf0, &actor->kf1, part_tbl);
}

static void aMBX_setup_flag_anime(MAILBOX_ACTOR* actor, int anime_idx) {
    aMBX_anime_info_c* info_p = &aMBX_animeTable[anime_idx];
    cKF_SkeletonInfo_R_c* kf1 = &actor->kf1;
    int mode = cKF_FRAMECONTROL_STOP;

    if (anime_idx == aMBX_ANIME_FLAG_UP_WAIT) {
        mode = cKF_FRAMECONTROL_REPEAT;
    }

    cKF_SkeletonInfo_R_init(kf1, kf1->skeleton, info_p->anim, info_p->start, info_p->end, info_p->start, 0.5f, 0.0f, mode, NULL);
    actor->anim_idx1 = anime_idx;
}

static void aMBX_check_take_mail(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    ACTOR* playerx = GET_PLAYER_ACTOR_ACTOR(play);

    if (playerx != NULL) {
        PLAYER_ACTOR* player = (PLAYER_ACTOR*)playerx;
        int arrange_idx = actor->arrange_idx;
        int pl_no = mHS_get_pl_no(arrange_idx);
        ACTOR* actorx = (ACTOR*)actor;
        int mbox_angle = actorx->shape_info.rotation.y + DEG2SHORT_ANGLE2(-45.0f);
        int mbox_pl_angle = actorx->player_angle_y;
        int dAngle = (s16)(mbox_pl_angle - mbox_angle);
        int abs_dAngle = ABS(dAngle);

#ifdef TARGET_PC
        /* The selected resident can be the indoor actor, or a guest moved onto
         * that slot. Neither is standing at this outdoor box. */
        {
            ACTOR* walk = play->actor_info.list[ACTOR_PART_PLAYER].actor;
            int here = FALSE;

            while (walk != NULL) {
                if (walk == playerx) {
                    here = TRUE;
                    break;
                }
                walk = walk->next_actor;
            }

            if ((here == FALSE) || (mPlib_player_slot_of(player) != pl_no)) {
                playerx = NULL;
            }
        }

        if (playerx != NULL)
#endif
        if (abs_dAngle < aMBX_PLAYER_OPEN_ANGLE && player->a_btn_pressed == TRUE && pl_no == Common_Get(player_no) && aMBX_item_is_this(player->item_in_front, arrange_idx)) {
// Aus version changed the reset count needed for the 'free roam' Resetti interaction
#if VERSION >= VER_GAFU01_00
            if (Common_Get(reset_flag) == TRUE && Now_Private->reset_count < 4) {
#else
            if (Common_Get(reset_flag) == TRUE && Now_Private->reset_count < 3) {
#endif
                Common_Set(reset_type, 5);
            } else if (!mPr_NullCheckPersonalID(&Save_Get(homes[arrange_idx]).ownerID)) {
                Submenu* submenu = &play->submenu;

                if (submenu->start_refuse == FALSE && submenu->start_refuse_timer == 0 && mPlib_able_submenu_type1((GAME*)play) && actor->req == 0) {
                    player->a_btn_triggers_submenu = TRUE;
                    actor->req = aMBX_REQUEST_OPEN;
#ifdef TARGET_PC
                    if ((arrange_idx >= 0) && (arrange_idx < PLAYER_NUM)) {
                        s_mbx_opener[arrange_idx] = NULL;
                    }
#endif
                }
            }
        }
    }
}

/* The acre keeps the prop name. Init also writes the dummy over that unit, and
 * a world restore can put the prop back. Either one is this mailbox. */
static int aMBX_item_is_this(mActor_name_t item, int arrange_idx) {
    return (item == (mActor_name_t)(DUMMY_MAILBOX0 + arrange_idx)) ||
           (item == (mActor_name_t)(ACTOR_PROP_MAILBOX0 + arrange_idx));
}

#ifdef TARGET_PC
/* The registered pad is 0 after the indoor leave/rejoin. The joined Controls
 * row is still this slot. */
static int aMBX_pad_for_slot(int slot) {
    int pad = (slot >= 0) ? mPlib_pad_for_player_slot(slot) : -1;
    int row;

    if ((pad > 0) || (slot < 0)) {
        return pad;
    }

    for (row = 1; row < PC_PLAYER_COUNT; row++) {
        if ((g_pc_coop_joined[row] != 0) && (g_pc_coop_guest_slot[row] == slot)) {
            mPlib_register_player_pad(slot, row);
            return row;
        }
    }

    /* One guest, and their actor is no longer on the slot join recorded. */
    if (slot != (int)Common_Get(player_no)) {
        int only = -1;
        int n = 0;

        for (row = 1; row < PC_PLAYER_COUNT; row++) {
            if (g_pc_coop_joined[row] != 0) {
                only = row;
                n++;
            }
        }

        if (n == 1) {
            mPlib_register_player_pad(slot, only);
            g_pc_coop_guest_slot[only] = slot;
            return only;
        }
    }

    return pad;
}

/* A guest opens the mailbox they own. The retail check above stays on the
 * selected resident; player_angle_y on this actor is that resident's line. */
static void aMBX_check_guest_open(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    int arrange_idx = actor->arrange_idx;
    int pl_no = mHS_get_pl_no(arrange_idx);
    ACTOR* walk = play->actor_info.list[ACTOR_PART_PLAYER].actor;

    if ((actor->req != 0) || (arrange_idx < 0) || (arrange_idx >= PLAYER_NUM)) {
        return;
    }

    /* Extra-player list hides a guest whose pad was cleared to 0. The joined
     * row is recovered in aMBX_pad_for_slot. */
    while (walk != NULL) {
        PLAYER_ACTOR* player = (PLAYER_ACTOR*)walk;
        ACTOR* actorx = (ACTOR*)actor;
        Private_c* priv;
        Submenu* side;
        int slot;
        int pad;
        int mbox_angle;
        int mbox_pl_angle;
        int dAngle;

        walk = walk->next_actor;

        if (player == NULL) {
            continue;
        }

        slot = mPlib_player_slot_of(player);
        /* The registered Controls row. pad_for_player returns 0 when this
         * actor is what the town lookup calls the selected resident. */
        pad = aMBX_pad_for_slot(slot);
        /* The mailbox moves before the player, so a_btn_pressed is still the
         * previous frame. The A edge is already on this pad. */
        if (chkTrigger_pad(pad, BUTTON_A) == FALSE && player->a_btn_pressed == FALSE) {
            continue;
        }

        /* slot == pl_no misses a guest moved onto the indoor resident's slot.
         * The unit in front is this mailbox either way. */
        if ((pad <= 0) || (pad >= mSM_SLOT_NUM)) {
            continue;
        }

        if (aMBX_item_is_this(player->item_in_front, arrange_idx) == FALSE) {
            continue;
        }

        mbox_angle = actorx->shape_info.rotation.y + DEG2SHORT_ANGLE2(-45.0f);
        mbox_pl_angle = search_position_angleY(&actorx->world.position, &player->actor_class.world.position);
        dAngle = (s16)(mbox_pl_angle - mbox_angle);
        if (ABS(dAngle) >= aMBX_PLAYER_OPEN_ANGLE) {
            continue;
        }

        priv = mPlib_private_for_slot(slot);
        side = mSM_side_slot_p(pad);
        if ((priv == NULL) || (side == NULL)) {
            continue;
        }

#if VERSION >= VER_GAFU01_00
        if (Common_Get(reset_flag) == TRUE && priv->reset_count < 4) {
#else
        if (Common_Get(reset_flag) == TRUE && priv->reset_count < 3) {
#endif
            Common_Set(reset_type, 5);
            return;
        }

        if (mPr_NullCheckPersonalID(&Save_Get(homes[arrange_idx]).ownerID)) {
            continue;
        }

        if (side->process_status != mSM_PROCESS_WAIT || side->menu_type != mSM_OVL_NONE ||
            side->start_refuse != FALSE || side->start_refuse_timer != 0 ||
            mPlib_able_submenu_type1_player((GAME*)play, player) == FALSE) {
            continue;
        }

        s_mbx_opener[arrange_idx] = player;
        player->a_btn_triggers_submenu = TRUE;
        actor->req = aMBX_REQUEST_OPEN;
        return;
    }
}

static PLAYER_ACTOR* aMBX_opener(MAILBOX_ACTOR* actor) {
    PLAYER_ACTOR* opener;

    if ((actor->arrange_idx < 0) || (actor->arrange_idx >= PLAYER_NUM)) {
        return NULL;
    }

    opener = s_mbx_opener[actor->arrange_idx];
    if ((opener != NULL) && (mPlib_player_slot_of(opener) < 0)) {
        s_mbx_opener[actor->arrange_idx] = NULL;
        return NULL;
    }

    return opener;
}

static void aMBX_bind_opener(PLAYER_ACTOR* opener) {
    if (opener != NULL) {
        mPlib_bind_player_actor(opener);
    }
}

static void aMBX_unbind_opener(PLAYER_ACTOR* opener) {
    if (opener != NULL) {
        mPlib_unbind_player_actor();
    }
}
#endif

static void aMBX_check_flag(MAILBOX_ACTOR* actor) {
    int anime_idx = aMBX_ANIME_FLAG_DOWN;
    int mail_count = mMl_count_use_mail_space(Save_Get(homes[actor->arrange_idx]).mailbox, HOME_MAILBOX_SIZE);

    if (mail_count != 0) {
        if (actor->anim_idx1 == aMBX_ANIME_FLAG_UP_WAIT || actor->anim_idx1 == aMBX_ANIME_NUM) {
            anime_idx = aMBX_ANIME_FLAG_UP_WAIT;
        } else {
            anime_idx = aMBX_ANIME_FLAG_UP;
        }
    }

    if (actor->anim_idx1 != anime_idx) {
        aMBX_setup_flag_anime(actor, anime_idx);
    }
}

static void aMBX_setup_flag_se_sub(u16 se_no, MAILBOX_ACTOR* actor, f32 frame) {
    if (cKF_FrameControl_passCheck_now(&actor->kf1.frame_control, frame) == TRUE) {
        sAdo_OngenTrgStart(se_no, &actor->actor_class.world.position);
    }
}

static void aMBX_setup_flag_se(MAILBOX_ACTOR* actor) {
    switch (actor->anim_idx1) {
        case aMBX_ANIME_FLAG_UP:
            aMBX_setup_flag_se_sub(0x433, actor, 15.0f);
            break;
        case aMBX_ANIME_FLAG_DOWN:
            aMBX_setup_flag_se_sub(0x434, actor, 15.0f);
            break;
    }
}

static void aMBX_wait(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    if (actor->kf0_state == cKF_STATE_STOPPED) {
        aMBX_check_take_mail(actor, play);
#ifdef TARGET_PC
        aMBX_check_guest_open(actor, play);
#endif
        switch (actor->req) {
            case aMBX_REQUEST_DELIVERY:
                aMBX_setupAction(actor, aMBX_ACT_OPEN_AND_CLOSE);
                break;
            case aMBX_REQUEST_OPEN:
                aMBX_setupAction(actor, aMBX_ACT_PL_WAIT);
                break;
        }
    }

    aMBX_check_flag(actor);
    if (actor->anim_idx1 == aMBX_ANIME_FLAG_UP && actor->kf1.frame_control.current_frame == actor->kf1.frame_control.end_frame) {
        aMBX_setup_flag_anime(actor, aMBX_ANIME_FLAG_UP_WAIT);
    }
}

static void aMBX_pl_wait(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    static s16 angle[] = { DEG2SHORT_ANGLE2(-135.0f), DEG2SHORT_ANGLE2(135.0f) };
    static f32 posX[] = { 24.0f, -24.0f };
#ifdef TARGET_PC
    PLAYER_ACTOR* opener = aMBX_opener(actor);
#endif
    int jumped;

#ifdef TARGET_PC
    aMBX_bind_opener(opener);
#endif
    jumped = mPlib_get_player_actor_main_index((GAME*)play) == mPlayer_INDEX_MAIL_JUMP;
#ifdef TARGET_PC
    aMBX_unbind_opener(opener);
#endif

    if (jumped) {
        aMBX_setupAction(actor, aMBX_ACT_PL_OPEN);
    } else {
        xyz_t pos;
        int idx = actor->arrange_idx & 1;

        pos.x = actor->actor_class.world.position.x + posX[idx];
        pos.z = actor->actor_class.world.position.z + 24.0f;
#ifdef TARGET_PC
        aMBX_bind_opener(opener);
#endif
        mPlib_request_main_mail_jump_type1((GAME*)play, &pos, angle[idx]);
#ifdef TARGET_PC
        aMBX_unbind_opener(opener);
#endif
    }
}

static void aMBX_open_and_close(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    cKF_FrameControl_c* fc0 = &actor->kf0.frame_control;
    
    if (cKF_FrameControl_passCheck_now(fc0, 88.0f) == TRUE) {
        aMBX_check_flag(actor);
    } else if (cKF_FrameControl_passCheck_now(fc0, 14.0f) == TRUE) {
        sAdo_OngenTrgStart(0x146, &actor->actor_class.world.position);
    } else if (cKF_FrameControl_passCheck_now(fc0, 80.0f) == TRUE) {
        sAdo_OngenTrgStart(0x147, &actor->actor_class.world.position);
    }

    if (actor->kf0_state == cKF_STATE_STOPPED) {
        actor->req = aMBX_REQUEST_NONE;
        aMBX_setupAction(actor, aMBX_ACT_WAIT);
    }
}

static void aMBX_pl_open(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    cKF_FrameControl_c* fc0 = &actor->kf0.frame_control;
    
    if (cKF_FrameControl_passCheck_now(fc0, 18.0f) == TRUE) {
        sAdo_OngenTrgStart(0x146, &actor->actor_class.world.position);
    }

    if (actor->kf0_state == cKF_STATE_STOPPED) {
#ifdef TARGET_PC
        PLAYER_ACTOR* opener = aMBX_opener(actor);
        int opener_slot = (opener != NULL) ? mPlib_player_slot_of(opener) : -1;
        int pad;
        int pl_no = mHS_get_pl_no(actor->arrange_idx);

        /* The host check clears the guest pointer and would open the town
         * submenu. The owner standing in this play is the one who pressed A. */
        if (opener == NULL) {
            ACTOR* walk = play->actor_info.list[ACTOR_PART_PLAYER].actor;

            while (walk != NULL) {
                PLAYER_ACTOR* cand = (PLAYER_ACTOR*)walk;
                int cand_slot = mPlib_player_slot_of(cand);

                if ((cand_slot == pl_no) || (aMBX_item_is_this(cand->item_in_front, actor->arrange_idx) != FALSE)) {
                    opener = cand;
                    opener_slot = cand_slot;
                    if ((actor->arrange_idx >= 0) && (actor->arrange_idx < PLAYER_NUM)) {
                        s_mbx_opener[actor->arrange_idx] = opener;
                    }
                    break;
                }
                walk = walk->next_actor;
            }
        }

        pad = aMBX_pad_for_slot(opener_slot);

        if (opener != NULL) {
            if ((pad > 0) && (pad < mSM_SLOT_NUM)) {
                Submenu* side = mSM_side_slot_p(pad);

                /* Actors keep running for a guest, so the close anim would play
                 * during the menu. Hold this open frame until their menu ends. */
                if ((side != NULL) && (s_mbx_menu_open[actor->arrange_idx] == FALSE)) {
                    mPlib_set_menu_opener_for_slot(pad, opener, pad, pl_no);
                    /* Held A stays set while this actor is menu-waited, and the
                     * other mailbox then treats it as a fresh open. */
                    opener->a_btn_pressed = FALSE;
                    mSM_open_submenu(side, mSM_OVL_INVENTORY, mSM_IV_OPEN_MAILBOX, 0);
                    side->process_status = mSM_PROCESS_PREWAIT;
                    side->mode = mSM_MODE_PRERENDER_INIT;
                    SetGameFrame(1);
                    s_mbx_menu_open[actor->arrange_idx] = TRUE;
                }

                if ((side != NULL) && (side->menu_type != mSM_OVL_NONE)) {
                    return;
                }
            }

            /* Pad 0 in this play is the resident. Anyone else must not open
             * the town submenu: that panel is the indoor resident's mail. */
            if ((pad != 0) || (opener_slot != pl_no)) {
                s_mbx_menu_open[actor->arrange_idx] = FALSE;
                mPlib_request_main_mail_land_from_submenu();
                aMBX_setupAction(actor, aMBX_ACT_PL_CLOSE);
                return;
            }
        } else {
            mPlib_request_main_mail_land_from_submenu();
            aMBX_setupAction(actor, aMBX_ACT_PL_CLOSE);
            return;
        }
#endif
        {
            Submenu* submenu = &play->submenu;

            mSM_open_submenu(submenu, mSM_OVL_INVENTORY, mSM_IV_OPEN_MAILBOX, 0);
        }
        aMBX_setupAction(actor, aMBX_ACT_PL_CLOSE);
    }
}

static void aMBX_pl_close(MAILBOX_ACTOR* actor, GAME_PLAY* play) {
    cKF_FrameControl_c* fc0 = &actor->kf0.frame_control;
    
    if (cKF_FrameControl_passCheck_now(fc0, 4.0f) == TRUE) {
        sAdo_OngenTrgStart(0x147, &actor->actor_class.world.position);
    }

    if (actor->kf0_state == cKF_STATE_STOPPED) {
        aMBX_check_flag(actor);
        actor->req = aMBX_REQUEST_NONE;
#ifdef TARGET_PC
        if ((actor->arrange_idx >= 0) && (actor->arrange_idx < PLAYER_NUM)) {
            s_mbx_opener[actor->arrange_idx] = NULL;
            s_mbx_menu_open[actor->arrange_idx] = FALSE;
        }
#endif
        aMBX_setupAction(actor, aMBX_ACT_WAIT);
    }
}

static void aMBX_setupAction(MAILBOX_ACTOR* actor, int action) {
    // clang-format off
    static aMBX_ACT_PROC process[] = {
        aMBX_wait,
        aMBX_pl_wait,
        aMBX_open_and_close,
        aMBX_pl_open,
        aMBX_pl_close,
    };
    // clang-format on

    int anim_idx = aMBX_animeSeqNoTable[action];
    aMBX_anime_info_c* info;
    cKF_SkeletonInfo_R_c* kf = &actor->kf0;
    
    actor->action = action;
    actor->act_proc = process[action];
    
    info = &aMBX_animeTable[anim_idx];
    cKF_SkeletonInfo_R_init(kf, kf->skeleton, info->anim, info->start, info->end, info->start, 0.5f, 0.0f, cKF_FRAMECONTROL_STOP, NULL);
    actor->anim_idx0 = anim_idx;
}

static void aMBX_actor_move(ACTOR* actorx, GAME* game) {
    MAILBOX_ACTOR* actor = (MAILBOX_ACTOR*)actorx;
    GAME_PLAY* play = (GAME_PLAY*)game;

    aMBX_anime_proc(actorx, play);
    actor->act_proc(actor, play);
    aMBX_setup_flag_se(actor);
}

static void aMBX_actor_init(ACTOR* actorx, GAME* game) {
    MAILBOX_ACTOR* actor = (MAILBOX_ACTOR*)actorx;

    actorx->mv_proc = aMBX_actor_move;
    actorx->dw_proc = aMBX_actor_draw;
    mFI_SetFG_common(DUMMY_MAILBOX0 + actor->arrange_idx, actorx->world.position, FALSE);
    aMBX_setupAction(actor, aMBX_ACT_WAIT);
    aMBX_check_flag(actor);
    actor->kf1.frame_control.current_frame = actor->kf1.frame_control.end_frame;
    aMBX_actor_move(actorx, game);
}
